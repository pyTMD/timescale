      y =  0.3790 - 0.0386 cos A - 0.1027 sin A - 0.0072 cos C + 0.0610 sin C  
         UT1-UTC = -0.0737 - 0.00024 (MJD - 61294) - (UT2-UT1)                 
                                                                               
